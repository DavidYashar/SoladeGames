# PostgreSQL — player accounts, points and tournament leaderboards.
# Create the schema with: npm run db:init
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/arcade

# Arc RPC (optional override)
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io

# USDC token (optional override for local anvil E2E)
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# PuzzleLeague contract address (set after `forge script` deployment)
NEXT_PUBLIC_LEAGUE_ADDRESS=
