# Arcade app configuration. Copy to .env.local and fill in.

# PostgreSQL: player accounts, tournament tables and best scores.
# Create the schema with: npm run db:init
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/arcade

# Solana cluster. Devnet until we deploy; nothing here is a secret.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# RPC endpoint (optional override; defaults to the public cluster endpoint).
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Arkade's test currency, created by `npm run solana:devnet`.
# 9 decimals, one token to the dollar, worthless outside devnet.
NEXT_PUBLIC_TEST_TOKEN_MINT=

# Server-side RPC for scripts that sign (devnet bootstrap, future payouts).
SOLANA_RPC_URL=https://api.devnet.solana.com
